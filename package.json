{
  "name": "lector-anotaciones-web",
  "private": true,
  "description": "Pruebas de la página del lector: núcleo (node --test) y navegador (Playwright). El paquete Python está en pyproject.toml.",
  "type": "module",
  "scripts": {
    "test:js": "node --test 'tests/js/**/*.test.js'",
    "test:web": "playwright test",
    "cobertura:js": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=65 --test-coverage-branches=83 --test-coverage-functions=85 'tests/js/**/*.test.js'",
    "cobertura:web": "node tests/web/herramientas/cobertura.mjs --limpiar && COBERTURA=1 playwright test && node tests/web/herramientas/cobertura.mjs --minimo 92",
    "formato": "prettier --check 'src/lector_anotaciones/web/nucleo/*.js' 'src/lector_anotaciones/web/pagina/*.js' 'tests/**/*.mjs' 'tests/js/*.js' 'src/lector_anotaciones/web/tipos/*.d.ts' 'herramientas/*.mjs'",
    "formatear": "prettier --write 'src/lector_anotaciones/web/nucleo/*.js' 'src/lector_anotaciones/web/pagina/*.js' 'tests/**/*.mjs' 'tests/js/*.js' 'src/lector_anotaciones/web/tipos/*.d.ts' 'herramientas/*.mjs'",
    "estilos": "node tests/web/herramientas/comparar-estilos.mjs",
    "tipos": "tsc -p tsconfig.json && tsc -p tsconfig.nucleo.json",
    "modulos": "node herramientas/modulos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "playwright": "1.56.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
