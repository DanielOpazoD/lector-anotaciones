{
  "name": "lector-anotaciones-web",
  "private": true,
  "description": "Pruebas de la página del lector: núcleo (node --test) y navegador (Playwright). El paquete Python está en pyproject.toml.",
  "type": "module",
  "scripts": {
    "test:js": "node --test 'tests/js/**/*.test.js'",
    "test:web": "node tests/web/smoke.mjs && node tests/web/biblioteca.mjs",
    "formato": "prettier --check 'src/lector_anotaciones/web/nucleo/*.js' 'src/lector_anotaciones/web/pagina/*.js' 'tests/**/*.mjs' 'tests/js/*.js'",
    "formatear": "prettier --write 'src/lector_anotaciones/web/nucleo/*.js' 'src/lector_anotaciones/web/pagina/*.js' 'tests/**/*.mjs' 'tests/js/*.js'",
    "estilos": "node tests/web/herramientas/comparar-estilos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "playwright": "1.56.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
